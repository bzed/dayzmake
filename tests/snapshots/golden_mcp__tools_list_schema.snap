        "pbo",
        "file"
      ],
      "type": "object"
    },
    "name": "pbo_cat"
  },
  {
    "description": "Unpack a PBO into a folder, all of it or the entries selected by only/exclude. Unsafe entry names are skipped with a warning.",
    "inputSchema": {
      "properties": {
        "exclude": {
          "description": "Glob patterns of entries to leave out (case-insensitive, / separators).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "force": {
          "description": "Overwrite existing target files.",
          "type": "boolean"
        },
        "only": {
          "description": "Glob patterns: write only the entries that match one (exclude wins).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "pbo": {
          "description": "PBO file.",
          "type": "string"
        },
        "target": {
          "description": "Folder to extract into.",
          "type": "string"
        },
        "use_prefix": {
          "description": "Extract into <target>/<prefix>/.",
          "type": "boolean"
        }
      },
      "required": [
        "pbo",
        "target"
      ],
      "type": "object"
    },
    "name": "pbo_unpack"
  },
  {
    "description": "Unpack every PBO of a DayZ install, a mod folder or a single PBO into one tree <target>/<prefix>/<entry>, optionally derapified, and write the prefix -> PBO map pbo-map.tsv. The tree replaces an existing target atomically with force.",
    "inputSchema": {
      "properties": {
        "derapify": {
          "description": "Write every rapified .bin as a .cpp of the same name.",
          "type": "boolean"
        },
        "exclude": {
          "description": "Glob patterns of entries to leave out (case-insensitive, / separators).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "force": {
          "description": "Replace an earlier extract result or an empty folder.",
          "type": "boolean"
        },
        "only": {
          "description": "Glob patterns: write only the entries that match one (exclude wins).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "source": {
          "description": "DayZ client or server folder, mod folder (dta/ and addons/ are searched) or one PBO.",
          "type": "string"
        },
        "target": {
          "description": "Folder to write the tree to.",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "type": "object"
    },
    "name": "extract"
  },
  {
    "description": "Pack a folder into a PBO without binarizing or rapifying.",
    "inputSchema": {
      "properties": {
        "exclude": {
          "description": "Glob patterns to leave out.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "force": {
          "description": "Overwrite existing target files.",
          "type": "boolean"
        },
        "headerext": {
          "description": "Header extensions as key=value.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "key": {
          "description": "Private key (.biprivatekey): sign the PBO after packing.",
          "type": "string"
        },
        "source": {
          "description": "Folder to pack.",
          "type": "string"
        },
        "target": {
          "description": "PBO file to write.",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "type": "object"
    },
    "name": "pbo_pack"
  },
  {
    "description": "Build a PBO from a folder, rapifying configs and binarizing models.",
    "inputSchema": {
      "properties": {
        "exclude": {
          "description": "Glob patterns to leave out.",
