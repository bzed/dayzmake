---
source: tests/golden_mcp.rs
expression: "r.result(2)[\"tools\"]"
---
[
  {
    "description": "Members of a DayZ script class from the installed scripts.pbo (vanilla; mods only when selected with mods).",
    "inputSchema": {
      "properties": {
        "dayz": {
          "description": "DayZ client/server directory (uses <dir>/dta/scripts.pbo) instead of the Steam install.",
          "type": "string"
        },
        "experimental": {
          "description": "Use the experimental branch instead of stable.",
          "type": "boolean"
        },
        "inherited": {
          "description": "Also show the base classes.",
          "type": "boolean"
        },
        "json": {
          "description": "Return JSON instead of text.",
          "type": "boolean"
        },
        "max": {
          "description": "At most this many lines or items (default 120).",
          "minimum": 0,
          "type": "integer"
        },
        "mods": {
          "description": "Also query these mods, comma separated: cf, cot, dabs, expansion, aliases (those four, if installed), all (every installed mod with scripts; the first run builds the caches and can take a while, later runs are quick; api_update with mods=all warms them), a workshop id, a mod name or @dir name (see api_mods) or a mod directory. Without it only vanilla is queried.",
          "type": "string"
        },
        "mods_only": {
          "description": "Show only what the selected mods declare.",
          "type": "boolean"
        },
        "name": {
          "description": "Class name.",
          "type": "string"
        },
        "refresh": {
          "description": "Rebuild the cached index first.",
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "name": "api_class"
  },
  {
    "description": "Case-insensitive regex over member names, signatures, docs, class names and enum items (so ^OnRPC finds the OnRPC methods).",
