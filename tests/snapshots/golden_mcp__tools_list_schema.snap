          "description": "Also query these mods, comma separated: cf, cot, dabs, expansion, aliases (those four, if installed), all (every installed mod with scripts; the first run builds the caches and can take a while, later runs are quick; api_update with mods=all warms them), a workshop id, a mod name or @dir name (see api_mods) or a mod directory. Without it only vanilla is queried.",
          "type": "string"
        },
        "regex": {
          "description": "Regular expression, matched against each line.",
          "type": "string"
        }
      },
      "required": [
        "regex"
      ],
      "type": "object"
    },
    "name": "api_grep"
  },
  {
    "description": "Look up a config class (config.bin and config.cpp of the game and the selected mods, merged in load order the way the engine does): its inheritance chain, its own and inherited properties each tagged with the class they come from, its direct subclasses and the PBOs that define it; a redefinition that changes or drops the base class (as the engine does) is reported as a base change. The path is a /-separated class path such as CfgVehicles/Hatchback_02, matched ignoring case.",
    "inputSchema": {
      "properties": {
        "dayz": {
          "description": "DayZ client/server directory (uses <dir>/dta/scripts.pbo) instead of the Steam install.",
          "type": "string"
        },
        "experimental": {
          "description": "Use the experimental branch instead of stable.",
          "type": "boolean"
        },
        "json": {
          "description": "Return JSON instead of text.",
          "type": "boolean"
        },
        "max": {
          "description": "At most this many lines or items (default 120).",
          "minimum": 0,
          "type": "integer"
        },
        "mods": {
          "description": "Also query these mods, comma separated: cf, cot, dabs, expansion, aliases (those four, if installed), all (every installed mod with scripts; the first run builds the caches and can take a while, later runs are quick; api_update with mods=all warms them), a workshop id, a mod name or @dir name (see api_mods) or a mod directory. Without it only vanilla is queried.",
          "type": "string"
        },
        "path": {
          "description": "The class path, for example CfgVehicles/Hatchback_02 or CfgWeapons/M4A1.",
          "type": "string"
        },
        "refresh": {
          "description": "Rebuild the cached index first.",
          "type": "boolean"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "name": "api_config"
  },
  {
    "description": "Compile-time defines of the selected indexes, optionally filtered by a regex.",
    "inputSchema": {
      "properties": {
        "dayz": {
