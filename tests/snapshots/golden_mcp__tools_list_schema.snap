  {
    "description": "List the installed mods (workshop id, name, directory, whether they have scripts); the names and ids can be used in the mods argument of the other api tools. Reading them is quick; querying all of them with mods=all builds the caches on the first run and can take a while; api_update with mods=all warms them.",
    "inputSchema": {
      "properties": {
        "dayz": {
          "description": "DayZ client/server directory instead of the Steam install.",
          "type": "string"
        },
        "experimental": {
